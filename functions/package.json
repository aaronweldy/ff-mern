{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "serve": "pnpm build && pnpm exec firebase emulators:start --only functions",
    "shell": "pnpm build && pnpm exec firebase functions:shell",
    "start": "pnpm shell",
    "deploy": "pnpm exec firebase deploy --only functions",
    "logs": "pnpm exec firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@ff-mern/ff-types": "workspace:*",
    "cheerio": "^1.0.0-rc.10",
    "firebase-admin": "^12.5.0",
    "firebase-functions": "latest"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.22.0",
    "firebase-functions-test": "^0.2.0",
    "firebase-tools": "^13.20.1",
    "typescript": "^4.5.5"
  },
  "private": true,
  "type": "module"
}
